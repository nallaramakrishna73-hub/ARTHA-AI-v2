# ARTHA AI Environment Configuration Example

# Server & Hosting
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini LLM API Key (If omitted, app runs in Demo Mode with fallback)
GEMINI_API_KEY=""

# External Financial Data Provider Keys
ALPHAVANTAGE_API_KEY=""
NEWS_API_KEY=""
HF_TOKEN=""

# Database & Cache
SQLITE_DB_PATH=artha.db
DATABASE_URL=postgres://artha:artha123@localhost:5432/arthadb
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_SECRET=artha-ai-super-secret-key-2026
JWT_REFRESH_SECRET=artha-ai-refresh-secret-key-2026

# Provider Fallback Debugging (e.g. FORCE_FAIL=yahoo)
FORCE_FAIL=""
